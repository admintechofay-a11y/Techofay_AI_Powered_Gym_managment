# ==========================================
# Techofay GymOS Environment Configuration
# ==========================================

# Node Environment
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
WEB_URL=http://localhost:3000

# Security & Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_random
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_random
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_signing_secret_min_32_characters

# Database (MongoDB Single-Node Replica Set)
MONGODB_URI=mongodb://localhost:27017/gymos?replicaSet=rs0
MONGODB_DEBUG=false

# Redis & Caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email (Mailpit locally, Nodemailer/SES in prod)
EMAIL_ADAPTER=mock # 'real' | 'mock'
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Techofay GymOS <noreply@gymos.techofay.com>"

# Object Storage (MinIO locally, AWS S3 in prod)
STORAGE_ADAPTER=mock # 'real' | 'mock'
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=gymos-uploads
S3_USE_SSL=false

# Payment Gateway (Razorpay)
PAYMENT_ADAPTER=mock # 'real' | 'mock'
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Business API
WHATSAPP_ADAPTER=mock # 'real' | 'mock'
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# SMS Gateway (Fast2SMS / Twilio)
SMS_ADAPTER=mock # 'real' | 'mock'
SMS_API_KEY=
SMS_SENDER_ID=

# Push Notifications (Web Push)
PUSH_ADAPTER=mock # 'real' | 'mock'
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@gymos.techofay.com

# AI Integration (Anthropic Claude)
AI_ADAPTER=mock # 'real' | 'mock'
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# Biometric Attendance Integration
BIOMETRIC_ADAPTER=mock # 'real' | 'mock'
BIOMETRIC_DEVICE_IP=
BIOMETRIC_DEVICE_PORT=4370
